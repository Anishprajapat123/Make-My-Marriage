# Local development configuration. Fill in values in an ignored .env.local file.
MONGODB_URI=
APP_BASE_URL=http://localhost:3000
AUTH_SECRET=
# Required in production only when requests arrive through a trusted host-filtering proxy.
AUTH_TRUST_HOST=false
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AWS_REGION=
S3_BUCKET=
SES_FROM_EMAIL=
# Select ses explicitly on Vercel when using AWS email.
EMAIL_PROVIDER=ses
BREVO_API_KEY=
# Plain verified sender email address, without a display name.
EMAIL_FROM=
INTERNAL_JOB_SECRET=
